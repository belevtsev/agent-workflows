{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "How a managed task reaches a reviewed commit",
    "locale": "en",
    "quality_profile": "showcase",
    "output": ".archify/task-workflow.html",
    "legend": {"entries": {
      "backend": {"label": "Writing role"},
      "messagebus": {"label": "Read-only role"},
      "external": {"label": "Developer decision"},
      "frontend": {"label": "Workflow action"}
    }}
  },
  "lanes": [
    {"id": "spec", "label": "Full path · Requirement"},
    {"id": "design", "label": "Full path · Design"},
    {"id": "delivery", "label": "Both paths"},
    {"id": "changes", "label": "Review findings"}
  ],
  "mainPath": ["tests", "checks", "code", "code-review", "commit"],
  "semanticChecks": {"allowedRoots": ["lookup", "small"], "allowedTerminals": ["commit"]},
  "nodes": [
    {"id": "lookup", "lane": "spec", "col": 0, "type": "messagebus", "label": "Find specs", "sublabel": "lookup"},
    {"id": "spec-writer", "lane": "spec", "col": 1, "type": "backend", "label": "Write spec", "sublabel": "spec-writer"},
    {"id": "spec-review", "lane": "spec", "col": 2, "type": "messagebus", "label": "Review spec", "sublabel": "reviewer"},
    {"id": "spec-approval", "lane": "spec", "col": 3, "type": "external", "icon": "person", "label": "Approve spec", "sublabel": "your decision"},
    {"id": "architect", "lane": "design", "col": 3, "type": "backend", "label": "Write design", "sublabel": "architect"},
    {"id": "design-review", "lane": "design", "col": 2, "type": "messagebus", "label": "Review design", "sublabel": "reviewer"},
    {"id": "design-approval", "lane": "design", "col": 1, "type": "external", "icon": "person", "label": "Approve design", "sublabel": "your decision"},
    {"id": "small", "lane": "delivery", "col": 0, "type": "frontend", "icon": "start", "label": "Small path", "sublabel": "known behavior"},
    {"id": "tests", "lane": "delivery", "col": 1, "type": "backend", "label": "Write tests", "sublabel": "quality-engineer"},
    {"id": "checks", "lane": "delivery", "col": 2, "type": "frontend", "icon": "backend", "label": "Run checks", "sublabel": "coordinator"},
    {"id": "code", "lane": "delivery", "col": 3, "type": "backend", "label": "Implement", "sublabel": "developer"},
    {"id": "code-review", "lane": "delivery", "col": 4, "type": "messagebus", "label": "Review changes", "sublabel": "reviewer"},
    {"id": "commit", "lane": "delivery", "col": 5, "type": "frontend", "icon": "success", "label": "Commit locally", "sublabel": "git role"},
    {"id": "revise", "lane": "changes", "col": 4, "type": "backend", "label": "Revise work", "sublabel": "original author"}
  ],
  "edges": [
    {"id": "find-spec", "from": "lookup", "to": "spec-writer"},
    {"id": "spec-to-review", "from": "spec-writer", "to": "spec-review"},
    {"id": "review-to-approval", "from": "spec-review", "to": "spec-approval"},
    {"id": "spec-to-design", "from": "spec-approval", "to": "architect"},
    {"id": "design-to-review", "from": "architect", "to": "design-review", "fromSide": "left", "toSide": "right", "route": "straight"},
    {"id": "design-to-approval", "from": "design-review", "to": "design-approval", "fromSide": "left", "toSide": "right", "route": "straight"},
    {"id": "tests-to-checks", "from": "tests", "to": "checks"},
    {"id": "small-to-tests", "from": "small", "to": "tests"},
    {"id": "design-to-tests", "from": "design-approval", "to": "tests"},
    {"id": "checks-to-code", "from": "checks", "to": "code"},
    {"id": "code-to-review", "from": "code", "to": "code-review"},
    {"id": "review-to-commit", "from": "code-review", "to": "commit"},
    {"id": "spec-rework", "from": "spec-review", "to": "spec-writer", "label": "revise", "variant": "dashed", "role": "return", "fromSide": "top", "toSide": "top"},
    {"id": "design-rework", "from": "design-review", "to": "architect", "label": "revise", "variant": "dashed", "role": "return", "fromSide": "bottom", "toSide": "bottom"},
    {"id": "tests-only", "from": "checks", "to": "code-review", "label": "tests only", "role": "branch", "fromSide": "top", "toSide": "top"},
    {"id": "review-findings", "from": "code-review", "to": "revise", "label": "findings", "fromSide": "bottom", "toSide": "top"},
    {"id": "review-again", "from": "revise", "to": "code-review", "label": "new review", "role": "return", "variant": "dashed", "fromSide": "right", "toSide": "right"}
  ]
}
