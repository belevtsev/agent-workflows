{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "The task workflow: behavioral verification is repository opt-in",
    "locale": "en",
    "quality_profile": "showcase",
    "output": ".archify/task-workflow.html",
    "legend": {
      "entries": {
        "backend": {"label": "Writing role"},
        "messagebus": {"label": "Read-only role"},
        "frontend": {"label": "Workflow action"},
        "security": {"label": "Git gate"},
        "external": {"label": "Adviser API or CLI"}
      }
    }
  },
  "lanes": [
    {"id": "roles", "label": "The role that works"},
    {"id": "checks", "label": "What comes next"},
    {"id": "approval", "label": "Full path: you approve"},
    {"id": "verification", "label": "Opt-in: finish worker intervals first"},
    {"id": "consultation", "label": "Experimental advice: default off"}
  ],
  "phases": [
    {"id": "any", "label": "Any stage", "fromCol": 0, "toCol": 0},
    {"id": "full", "label": "Full path only", "fromCol": 1, "toCol": 2},
    {"id": "both", "label": "Both paths: the small path starts here", "fromCol": 3, "toCol": 5, "variant": "emphasis"}
  ],
  "mainPath": ["spec-writer", "architect", "quality-engineer", "developer", "git"],
  "nodes": [
    {"id": "lookup", "lane": "roles", "col": 0, "type": "messagebus", "label": "lookup", "sublabel": "files and facts"},
    {"id": "spec-writer", "lane": "roles", "col": 1, "type": "backend", "label": "spec-writer", "sublabel": "specification"},
    {"id": "architect", "lane": "roles", "col": 2, "type": "backend", "label": "architect", "sublabel": "design and tasks"},
    {"id": "quality-engineer", "lane": "roles", "col": 3, "type": "backend", "label": "quality-engineer", "sublabel": "tests first"},
    {"id": "developer", "lane": "roles", "col": 4, "type": "backend", "label": "developer", "sublabel": "the code"},
    {"id": "git", "lane": "roles", "col": 5, "type": "messagebus", "label": "git", "sublabel": "the commit"},
    {"id": "roles-check", "lane": "checks", "col": 0, "type": "frontend", "label": "kitsu role check", "sublabel": "after every role", "icon": "backend"},
    {"id": "spec-review", "lane": "checks", "col": 1, "type": "messagebus", "label": "reviewer", "sublabel": "independent"},
    {"id": "design-review", "lane": "checks", "col": 2, "type": "messagebus", "label": "reviewer", "sublabel": "independent"},
    {"id": "tests-run", "lane": "checks", "col": 3, "type": "frontend", "label": "kitsu check run", "sublabel": "runs your checks", "icon": "backend"},
    {"id": "code-review", "lane": "checks", "col": 4, "type": "messagebus", "label": "reviewer", "sublabel": "findings go back"},
    {"id": "gate", "lane": "checks", "col": 5, "type": "security", "label": "the gate", "sublabel": "allows or denies"},
    {"id": "spec-approval", "lane": "approval", "col": 1, "type": "frontend", "label": "Approve spec", "sublabel": "your decision", "icon": "backend"},
    {"id": "design-approval", "lane": "approval", "col": 2, "type": "frontend", "label": "Approve design", "sublabel": "your decision", "icon": "backend"},
    {"id": "verify-plan", "lane": "verification", "col": 3, "type": "frontend", "label": "check plan", "sublabel": "targets + gaps", "icon": "backend", "width": 92},
    {"id": "verify-task", "lane": "verification", "col": 4, "type": "frontend", "label": "task verify", "sublabel": "then summary", "icon": "backend", "width": 92},
    {"id": "verify-full", "lane": "verification", "col": 5, "type": "frontend", "label": "Full checks", "sublabel": "local evidence", "icon": "backend", "width": 92},
    {"id": "consult-access", "lane": "consultation", "col": 0, "type": "frontend", "label": "Explicit opt-in", "sublabel": "definition + access", "icon": "backend"},
    {"id": "consult-bind", "lane": "consultation", "col": 1, "type": "frontend", "label": "Bind task", "sublabel": "snapshot policy", "icon": "backend"},
    {"id": "consult-scope", "lane": "consultation", "col": 2, "type": "frontend", "label": "Scope check", "sublabel": "after role returns", "icon": "backend"},
    {"id": "consult-run", "lane": "consultation", "col": 3, "type": "external", "label": "Adviser API/CLI", "sublabel": "kitsu adviser ask"},
    {"id": "consult-record", "lane": "consultation", "col": 4, "type": "frontend", "label": "Record decision", "sublabel": "answer + rationale", "icon": "backend"},
    {"id": "consult-resume", "lane": "consultation", "col": 5, "type": "frontend", "label": "Resume the role", "sublabel": "same job + limits", "icon": "backend"}
  ],
  "edges": [
    {"id": "spec-design", "from": "spec-writer", "to": "architect"},
    {"id": "design-tests", "from": "architect", "to": "quality-engineer"},
    {"id": "tests-code", "from": "quality-engineer", "to": "developer"},
    {"id": "code-commit", "from": "developer", "to": "git"},
    {"id": "spec-to-review", "from": "spec-writer", "to": "spec-review"},
    {"id": "design-to-review", "from": "architect", "to": "design-review"},
    {"id": "tests-to-run", "from": "quality-engineer", "to": "tests-run"},
    {"id": "code-to-review", "from": "developer", "to": "code-review"},
    {"id": "commit-to-gate", "from": "git", "to": "gate"},
    {"id": "spec-approval", "from": "spec-review", "to": "spec-approval", "route": "drop", "fromSide": "bottom", "toSide": "top"},
    {"id": "design-approval", "from": "design-review", "to": "design-approval", "route": "drop", "fromSide": "bottom", "toSide": "top"},
    {"id": "plan-verify", "from": "verify-plan", "to": "verify-task"},
    {"id": "verify-final", "from": "verify-task", "to": "verify-full"},
    {"id": "access-bind", "from": "consult-access", "to": "consult-bind"},
    {"id": "bind-scope", "from": "consult-bind", "to": "consult-scope"},
    {"id": "scope-consult", "from": "consult-scope", "to": "consult-run"},
    {"id": "consult-answer", "from": "consult-run", "to": "consult-record"},
    {"id": "answer-resume", "from": "consult-record", "to": "consult-resume"}
  ]
}
