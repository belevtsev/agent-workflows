  "cards": [
    {
      "dot": "rose",
      "title": "Review loops",
      "items": [
        "Findings go back to the author of that stage",
        "The review cap applies per stage",
        "Test review runs before integration, without the code",
        "Code review reads the integrated source against the contract, the design and the coverage profile",
        "Each test the adversarial tester keeps fails on that source and is a finding for the implementer"
      ]
    },
    {
      "dot": "cyan",
      "title": "When stages run",
      "items": [
        "A small task runs none of these stages: its author writes the tests and a reviewer checks them",
        "A reviewed spec or a precise request skips the spec stage",
        "The adversarial tester runs only when the plan opts in at classify, in parallel with the code review"
      ]
    }
  ]
