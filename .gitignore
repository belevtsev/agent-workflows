# Optional skill-tool environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local credentials and machine state must stay outside source control.
.env
.env.*
*.pem
*.key

# Editor and operating-system files
.DS_Store
*.swp
*.swo

# Native build and release artifacts
.bin/
.bin.lock/
dist/
.cw-release-*/

# Claude Code local settings and worktrees
.claude/

# Generated local diagrams and their delivery/browser evidence
.archify/

# Diagram specifications are tracked; rendered HTML and machine-specific receipts are not.
docs/diagrams/*.delivery.json
docs/diagrams/*.html
.openidea/
